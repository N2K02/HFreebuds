<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the paired earbuds (Android calls it "Nearby devices") -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Checks GitHub for app updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installs its own updates (Android asks the user first) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Find my earbuds: turns the media volume up while the chirp plays, then back -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="HFreebuds"
        android:theme="@style/Theme.HFreebuds">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: switch noise control -->
        <service
            android:name=".NoiseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Noise control"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: earbuds battery (last reading; tap to check again) -->
        <service
            android:name=".BatteryTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_battery"
            android:label="Earbuds battery"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shares a downloaded update APK with Android's installer (read-only, not exported) -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
